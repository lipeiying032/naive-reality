[Unit]
Description=naivereal naive proxy server (official kernel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=naivereal
Group=naivereal
ExecStart=/usr/local/bin/naive /etc/naivereal/naive.json
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
