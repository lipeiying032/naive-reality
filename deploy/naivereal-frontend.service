[Unit]
Description=naivereal REALITY frontend
After=naivereal.service
Requires=naivereal.service

[Service]
Type=simple
User=naivereal
Group=naivereal
ExecStart=/usr/local/bin/naivereal-frontend /etc/naivereal/frontend.toml
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
