# Explicit alternative to REALITY. Requires your own certificate and website.
# The client must use standard quic:// WITHOUT REALITY or custom QUIC options.
mode = "origin"
listen = "0.0.0.0:443"

[tls]
cert = "/etc/naivereal/fullchain.pem"
key = "/etc/naivereal/privkey.pem"

[origin]
web_root = "/var/www/naivereal"
username = "user"
password = "replace-me"
# Optional TCP HTTPS website for browsers to discover H3 through Alt-Svc.
# It serves the website only. Proxy CONNECT is available over H3.
# Omit this if another HTTPS server advertises H3 for this origin.
tcp_listen = "0.0.0.0:443"

[upstream]
# Run the official naive HTTP server with the SAME username/password.
addr = "127.0.0.1:18080"
