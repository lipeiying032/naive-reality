+# NAIVEREAL_TARGETS_BEGIN
+# The native naive-protocol HTTP/3 server. It lives in this package because the
+# QUICHE tool headers are addressed as "quic/tools/..." inside it. Nothing in
+# QUICHE's own source is modified.
+cc_library(
+    name = "naive_server_backend",
+    srcs = [
+        "naive_posix_client_socket.cc",
+        "naive_server_backend.cc",
+    ],
+    hdrs = [
+        "naive_posix_client_socket.h",
+        "naive_server_backend.h",
+    ],
+    visibility = ["//visibility:public"],
+    deps = [
+        ":io_tool_support",
+        ":quiche_core",
+        ":quiche_tool_support",
+        "@com_google_absl//absl/container:flat_hash_map",
+        "@com_google_absl//absl/status",
+        "@com_google_absl//absl/status:statusor",
+        "@com_google_absl//absl/strings",
+    ],
+)
+
+cc_binary(
+    name = "naivereal_h3_server",
+    srcs = ["naive_h3_server_bin.cc"],
+    visibility = ["//visibility:public"],
+    deps = [
+        ":naive_server_backend",
+        ":io_tool_support",
+        ":quic_server_factory",
+        ":quic_toy_server",
+        ":quiche_core",
+        ":quiche_tool_support",
+        "@com_google_absl//absl/flags:flag",
+        "@com_google_absl//absl/strings",
+    ],
+)
+# NAIVEREAL_TARGETS_END
