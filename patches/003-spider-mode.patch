+void NaiveProxy::DoSpiderMode() {
+  if (spider_mode_triggered_) {
+    return;
+  }
+  spider_mode_triggered_ = true;
+  LOG(WARNING) << "REALITY: reached real target site, spider mode";
+  // Issue one ordinary-TLS GET to https://<server_name>/ so the client looks
+  // like a normal visitor to the real target, then fail the connection.
+  // REALITY is suspended for the duration of this fetch so it uses ordinary
+  // TLS rather than the REALITY ClientHello.
+  SetRealityConfigSuspended(true);
+  auto getter = std::make_unique<PreambleGetter>(
+      proxy_info_, session_, NetworkAnonymizationKey::CreateTransient(),
+      net_log_);
+  PreambleGetter* getter_ptr = getter.get();
+  getter_ptr->Start(base::BindOnce(&NaiveProxy::OnSpiderComplete,
+                                   weak_ptr_factory_.GetWeakPtr(),
+                                   std::move(getter)));
+}
+
+void NaiveProxy::OnSpiderComplete(std::unique_ptr<PreambleGetter> getter,
+                                  int /*result*/) {
+  SetRealityConfigSuspended(false);
+  // |getter| is destroyed here; the fetch result is deliberately ignored.
+}
