+// REALITY client mode (experimental).
+//
+// SSL_set1_reality_config configures |ssl| to use the REALITY protocol
+// (https://github.com/XTLS/REALITY) for its outbound handshake. |public_key|
+// is the server's static X25519 public key (32 bytes) and |short_id| is the
+// right-zero-padded 8-byte short id. When set, the client restricts the
+// handshake to TLS 1.3, restricts key shares to X25519, offers only the h2
+// ALPN protocol, disables session tickets/PSK, and replaces the legacy session
+// id in the ClientHello with an authenticated-encryption blob. It returns one
+// on success and zero on failure (including when |ssl| is a server).
+OPENSSL_EXPORT int SSL_set1_reality_config(SSL *ssl,
+                                           const uint8_t public_key[32],
+                                           const uint8_t short_id[8]);
+
+// SSL_clear_reality_config disables REALITY mode on |ssl| and clears any
+// derived key material.
+OPENSSL_EXPORT void SSL_clear_reality_config(SSL *ssl);
+
+// SSL_reality_verify_certificate checks whether the peer's leaf certificate
+// (|leaf_der|/|leaf_der_len|) is the REALITY server's self-signed Ed25519
+// certificate. It returns one when REALITY is configured on |ssl| and the
+// leaf's Ed25519 public key matches HMAC-SHA512(AuthKey, public_key) against
+// the certificate signature; otherwise it returns zero. The caller should use
+// it to skip normal chain verification when it returns one.
+OPENSSL_EXPORT int SSL_reality_verify_certificate(SSL *ssl,
+                                                  const uint8_t *leaf_der,
+                                                  size_t leaf_der_len);
+
 
