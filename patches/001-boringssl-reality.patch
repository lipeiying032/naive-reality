+// limitations under the License.
+
+#include <openssl/ssl.h>
+
+#include <string.h>
+#include <time.h>
+
+#include <openssl/aead.h>
+#include <openssl/bytestring.h>
+#include <openssl/curve25519.h>
+#include <openssl/digest.h>
+#include <openssl/err.h>
+#include <openssl/evp.h>
+#include <openssl/hkdf.h>
+#include <openssl/hmac.h>
+#include <openssl/mem.h>
+#include <openssl/x509.h>
+
+#include "../crypto/internal.h"
+#include "internal.h"
+#include "reality.h"
+
+namespace bssl {
+namespace {
+
+// The REALITY client version, encoded as three bytes (major.minor.patch).
+// Matches the reference Go client (frontend/internal/realitytest) that passed
+// interop with the xtls/reality server fork: version 1.0.0 = {1, 0, 0}. This is
+// NOT the TLS version.
+static const uint8_t kRealityClientVersion[3] = {1, 0, 0};
+
+// reality_derive_auth_key computes the REALITY AuthKey
+//   HKDF-SHA256(X25519(client_ephemeral_private, server_static_public),
+//               salt=client_random[0:20], info="REALITY")
+// from the X25519 key share and writes it to |out_key|.
+bool reality_derive_auth_key(SSL_HANDSHAKE *hs, uint8_t out_key[32]) {
+  SSL *const ssl = hs->ssl;
+  uint8_t private_key[32];
+  bool found = false;
+  for (const auto &key_share : hs->key_shares) {
+    if (key_share->GroupID() != SSL_GROUP_X25519) {
+      continue;
+    }
+    ScopedCBB cbb;
+    if (!CBB_init(cbb.get(), 32) ||
+        !key_share->SerializePrivateKey(cbb.get())) {
+      return false;
+    }
+    uint8_t *data;
+    size_t len;
+    if (!CBB_finish(cbb.get(), &data, &len) || len != 32) {
+      return false;
+    }
+    OPENSSL_memcpy(private_key, data, sizeof(private_key));
+    found = true;
+    break;
+  }
+  if (!found) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+
+  uint8_t shared[32];
+  if (!X25519(shared, private_key, ssl->reality_public_key)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+
+  static const char kInfo[] = "REALITY";
+  if (!HKDF(out_key, 32, EVP_sha256(), shared, sizeof(shared),
+            ssl->s3->client_random, 20,
+            reinterpret_cast<const uint8_t *>(kInfo), sizeof(kInfo) - 1)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+  return true;
+}
+
+// reality_seal_session_id computes the 32-byte REALITY session id blob
+// (AES-256-GCM ciphertext || tag) with nonce client_random[20:32] and AAD
+// |hello| (the serialized ClientHello with a zeroed session id).
+bool reality_seal_session_id(SSL_HANDSHAKE *hs, const uint8_t auth_key[32],
+                             uint8_t out[32], const uint8_t *hello,
+                             size_t hello_len) {
+  SSL *const ssl = hs->ssl;
+  // Plaintext: version(3) | 0x00 reserved | unix_time(4, big-endian) |
+  // short_id(8).
+  uint8_t plaintext[16];
+  OPENSSL_memcpy(plaintext, kRealityClientVersion, 3);
+  plaintext[3] = 0;
+  uint32_t now = static_cast<uint32_t>(time(nullptr));
+  plaintext[4] = static_cast<uint8_t>(now >> 24);
+  plaintext[5] = static_cast<uint8_t>(now >> 16);
+  plaintext[6] = static_cast<uint8_t>(now >> 8);
+  plaintext[7] = static_cast<uint8_t>(now);
+  OPENSSL_memcpy(plaintext + 8, ssl->reality_short_id, 8);
+
+  ScopedEVP_AEAD_CTX aead_ctx;
+  if (!EVP_AEAD_CTX_init(aead_ctx.get(), EVP_aead_aes_256_gcm(), auth_key, 32,
+                         EVP_AEAD_DEFAULT_TAG_LENGTH, nullptr)) {
+    return false;
+  }
+  size_t out_len = 0;
+  if (!EVP_AEAD_CTX_seal(aead_ctx.get(), out, &out_len, 32,
+                         ssl->s3->client_random + 20, 12, plaintext,
+                         sizeof(plaintext), hello, hello_len) ||
+      out_len != 32) {
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+bool ssl_reality_patch_client_hello(SSL_HANDSHAKE *hs, Array<uint8_t> &msg) {
+  SSL *const ssl = hs->ssl;
+  if (!ssl->reality_configured) {
+    return true;
+  }
+  // The legacy session id is at offset 39: 4-byte handshake header, 2-byte
+  // legacy_version, 32-byte random, then the 1-byte session-id length prefix.
+  if (msg.size() < 39 + 32 || hs->session_id.size() != 32) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+  OPENSSL_memset(msg.data() + 39, 0, 32);
+
+  uint8_t auth_key[32];
+  if (!reality_derive_auth_key(hs, auth_key)) {
+    return false;
+  }
+
+  uint8_t sealed[32];
+  if (!reality_seal_session_id(hs, auth_key, sealed, msg.data(), msg.size())) {
+    return false;
+  }
+  OPENSSL_memcpy(msg.data() + 39, sealed, sizeof(sealed));
+  OPENSSL_memcpy(hs->session_id.data(), sealed, sizeof(sealed));
+
+  OPENSSL_memcpy(ssl->reality_auth_key, auth_key, sizeof(auth_key));
+  ssl->reality_auth_key_set = true;
+  return true;
+}
+
+}  // namespace bssl
+
+int SSL_set1_reality_config(SSL *ssl, const uint8_t public_key[32],
+                            const uint8_t short_id[8]) {
+  if (ssl == nullptr || public_key == nullptr || short_id == nullptr ||
+      ssl->server) {
+    return 0;
+  }
+  static const uint16_t kX25519 = SSL_GROUP_X25519;
+  static const uint8_t kH2Alpn[] = {2, 'h', '2'};
+  if (!SSL_set_min_proto_version(ssl, TLS1_3_VERSION) ||
+      !SSL_set_max_proto_version(ssl, TLS1_3_VERSION) ||
+      !SSL_set1_group_ids(ssl, &kX25519, 1) ||
+      !SSL_set1_client_key_shares(ssl, &kX25519, 1) ||
+      SSL_set_alpn_protos(ssl, kH2Alpn, sizeof(kH2Alpn)) != 0) {
+    return 0;
+  }
+  SSL_set_options(ssl, SSL_OP_NO_TICKET);
+
+  bssl::OPENSSL_memcpy(ssl->reality_public_key, public_key, 32);
+  bssl::OPENSSL_memcpy(ssl->reality_short_id, short_id, 8);
+  ssl->reality_configured = true;
+  ssl->reality_auth_key_set = false;
+  return 1;
+}
+
+void SSL_clear_reality_config(SSL *ssl) {
+  if (ssl == nullptr) {
+    return;
+  }
+  ssl->reality_configured = false;
+  ssl->reality_auth_key_set = false;
+  OPENSSL_cleanse(ssl->reality_public_key, sizeof(ssl->reality_public_key));
+  OPENSSL_cleanse(ssl->reality_short_id, sizeof(ssl->reality_short_id));
+  OPENSSL_cleanse(ssl->reality_auth_key, sizeof(ssl->reality_auth_key));
+}
+
+int SSL_reality_verify_certificate(SSL *ssl, const uint8_t *leaf_der,
+                                   size_t leaf_der_len) {
+  if (ssl == nullptr || leaf_der == nullptr || !ssl->reality_configured ||
+      !ssl->reality_auth_key_set) {
+    return 0;
+  }
+
+  const uint8_t *der = leaf_der;
+  bssl::UniquePtr<X509> x509(d2i_X509(nullptr, &der, (long)leaf_der_len));
+  if (x509 == nullptr) {
+    return 0;
+  }
+
+  bssl::UniquePtr<EVP_PKEY> pkey(X509_get_pubkey(x509.get()));
+  if (pkey == nullptr || EVP_PKEY_id(pkey.get()) != EVP_PKEY_ED25519) {
+    return 0;
+  }
+  uint8_t pub[32];
+  size_t pub_len = sizeof(pub);
+  if (!EVP_PKEY_get_raw_public_key(pkey.get(), pub, &pub_len) ||
+      pub_len != sizeof(pub)) {
+    return 0;
+  }
+
+  const ASN1_BIT_STRING *sig;
+  X509_get0_signature(&sig, nullptr, x509.get());
+  if (sig == nullptr || sig->length != 64) {
+    return 0;
+  }
+
+  // expected = HMAC-SHA512(AuthKey, ed25519_public_key).
+  uint8_t expected[64];
+  unsigned expected_len = 0;
+  bssl::UniquePtr<HMAC_CTX> hmac(HMAC_CTX_new());
+  if (hmac == nullptr ||
+      !HMAC_Init_ex(hmac.get(), ssl->reality_auth_key,
+                    sizeof(ssl->reality_auth_key), EVP_sha512(), nullptr) ||
+      !HMAC_Update(hmac.get(), pub, sizeof(pub)) ||
+      !HMAC_Final(hmac.get(), expected, &expected_len) ||
+      expected_len != sizeof(expected)) {
+    return 0;
+  }
+
+  return CRYPTO_memcmp(expected, sig->data, sizeof(expected)) == 0;
+}
