+#ifndef OPENSSL_HEADER_SSL_REALITY_H
+#define OPENSSL_HEADER_SSL_REALITY_H
+
+#include <openssl/base.h>
+
+#include "internal.h"
+
+namespace bssl {
+
+// ssl_reality_patch_client_hello replaces the legacy session id in |msg| (a
+// fully serialized TLS 1.3 ClientHello including the 4-byte handshake header)
+// with the REALITY authenticated-encryption blob. It derives the REALITY
+// AuthKey from the X25519 key share and stores it on |hs->ssl|. It returns
+// true on success and false on error. If REALITY is not configured on
+// |hs->ssl|, it does nothing and returns true.
+bool ssl_reality_patch_client_hello(SSL_HANDSHAKE *hs, Array<uint8_t> &msg);
+
+}  // namespace bssl
+
+#endif  // OPENSSL_HEADER_SSL_REALITY_H
