+void BbrSender::ApplyProfileFromFlags() {
+  const int32_t profile = GetQuicFlag(quic_bbr_profile);
+  congestion_window_gain_constant_ =
+      static_cast<float>(GetQuicFlag(quic_bbr_cwnd_gain));
+  switch (profile) {
+    case 1:  // Hysteria2 aggressive.
+      set_high_gain(3.0f);
+      set_high_cwnd_gain(2.25f);
+      congestion_window_gain_constant_ = 2.5f;
+      num_startup_rtts_ = 4;
+      enable_ack_aggregation_during_startup_ = true;
+      expire_ack_aggregation_in_startup_ = true;
+      bytes_lost_multiplier_while_detecting_overshooting_ = 2;
+      break;
+    case 2:  // Hysteria2 conservative.
+      set_high_gain(2.25f);
+      set_high_cwnd_gain(1.75f);
+      congestion_window_gain_constant_ = 1.75f;
+      num_startup_rtts_ = 2;
+      drain_to_target_ = true;
+      detect_overshooting_ = true;
+      bytes_lost_multiplier_while_detecting_overshooting_ = 1;
+      break;
+    default:  // standard: keep quiche defaults.
+      set_high_cwnd_gain(kDerivedHighCWNDGain);
+      break;
+  }
+}
