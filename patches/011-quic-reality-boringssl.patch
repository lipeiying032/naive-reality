+// reality_seal_random computes the 32-byte REALITY auth payload for QUIC,
+// which is carried in the ClientHello random field. |hello| must be the full
+// serialized ClientHello with the random field (bytes 6..38) already zeroed;
+// the salt and nonce are derived from SHA-256(hello), matching the Go
+// applyRealityClientHelloRandom / verifyClientHelloRandom.
+bool reality_seal_random(SSL_HANDSHAKE *hs, const uint8_t auth_key[32],
+                         uint8_t out[32], const uint8_t *hello,
+                         size_t hello_len) {
+  SSL *const ssl = hs->ssl;
+  uint8_t ad_hash[32];
+  if (!EVP_Digest(hello, hello_len, ad_hash, nullptr, EVP_sha256(), nullptr)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+
+  // Plaintext: version(3) | 0x00 reserved | unix_time(4, big-endian) |
+  // short_id(8).
+  uint8_t plaintext[16];
+  OPENSSL_memcpy(plaintext, kRealityClientVersion, 3);
+  plaintext[3] = 0;
+  uint32_t now = static_cast<uint32_t>(time(nullptr));
+  plaintext[4] = static_cast<uint8_t>(now >> 24);
+  plaintext[5] = static_cast<uint8_t>(now >> 16);
+  plaintext[6] = static_cast<uint8_t>(now >> 8);
+  plaintext[7] = static_cast<uint8_t>(now);
+  OPENSSL_memcpy(plaintext + 8, ssl->reality_short_id, 8);
+
+  ScopedEVP_AEAD_CTX aead_ctx;
+  if (!EVP_AEAD_CTX_init(aead_ctx.get(), EVP_aead_aes_256_gcm(), auth_key, 32,
+                         EVP_AEAD_DEFAULT_TAG_LENGTH, nullptr)) {
+    return false;
+  }
+  size_t out_len = 0;
+  if (!EVP_AEAD_CTX_seal(aead_ctx.get(), out, &out_len, 32, ad_hash + 20, 12,
+                         plaintext, sizeof(plaintext), hello, hello_len) ||
+      out_len != 32) {
+    return false;
+  }
+  return true;
+}
