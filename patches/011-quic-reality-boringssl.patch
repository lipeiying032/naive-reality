+// SSL_set1_reality_config_quic is the QUIC variant of
+// SSL_set1_reality_config. It configures REALITY for an outbound QUIC
+// handshake: the auth payload is sealed into the ClientHello random field
+// (the session id stays empty, as QUIC requires) and the CertificateVerify
+// signature is not verified. Unlike the TCP variant it does not restrict the
+// key-share groups, so the ClientHello keeps Chromium's default groups and
+// hybrid X25519MLKEM768 key share.
+OPENSSL_EXPORT int SSL_set1_reality_config_quic(
+    SSL *ssl, const uint8_t public_key[32], const uint8_t short_id[8]);
