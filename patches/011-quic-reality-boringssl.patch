+// SSL_set1_reality_config_quic is the QUIC variant of
+// SSL_set1_reality_config. Unlike the TCP variant it does not restrict the
+// key-share groups to X25519-only: the QUIC stack keeps Chromium's default
+// groups/hybrid key shares (the server's ClientHelloVerifier accepts both
+// X25519 and X25519MLKEM768), which preserves the Chrome QUIC fingerprint.
+int SSL_set1_reality_config_quic(SSL *ssl, const uint8_t public_key[32],
+                                 const uint8_t short_id[8]) {
+  if (ssl == nullptr || public_key == nullptr || short_id == nullptr ||
+      ssl->server) {
+    return 0;
+  }
+  if (!SSL_set_min_proto_version(ssl, TLS1_3_VERSION) ||
+      !SSL_set_max_proto_version(ssl, TLS1_3_VERSION)) {
