+  bssl::OPENSSL_memcpy(ssl->reality_public_key, public_key, 32);
+  bssl::OPENSSL_memcpy(ssl->reality_short_id, short_id, 8);
+  ssl->reality_configured = true;
+  ssl->reality_quic = true;
   ssl->reality_auth_key_set = false;
   return 1;
