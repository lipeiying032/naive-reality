+// Copyright 2025. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/socket/reality_config.h"
+
+#include <utility>
+
+namespace net {
+namespace {
+
+// naive.exe runs a single IO message loop, so no locking is needed (this
+// mirrors the existing g_duplicate_switch_collector pattern in
+// net/tools/naive/naive_command_line.cc).
+std::optional<RealityConfig> g_reality_config;
+bool g_reality_suspended = false;
+
+}  // namespace
+
+void SetRealityConfig(std::optional<RealityConfig> config) {
+  g_reality_config = std::move(config);
+}
+
+const RealityConfig* GetRealityConfig() {
+  if (g_reality_suspended) {
+    return nullptr;
+  }
+  if (g_reality_config.has_value()) {
+    return &g_reality_config.value();
+  }
+  return nullptr;
+}
+
+void SetRealityConfigSuspended(bool suspended) {
+  g_reality_suspended = suspended;
+}
+
+}  // namespace net
