@@ -0,0 +1,43 @@
+// Copyright 2025. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_SOCKET_REALITY_CONFIG_H_
+#define NET_SOCKET_REALITY_CONFIG_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "net/base/net_export.h"
+
+namespace net {
+
+// REALITY client configuration (see patches/README.md). It is applied to every
+// SSLClientSocketImpl connection; naive.exe is single-threaded and only makes
+// proxy TLS connections in its normal mode, so a process-wide value is
+// sufficient (documented assumption; see README.md).
+struct NET_EXPORT RealityConfig {
+  // SNI presented in the ClientHello (the "target" server name).
+  std::string server_name;
+  // Server static X25519 public key (32 bytes).
+  std::array<uint8_t, 32> public_key;
+  // Right-zero-padded short id (8 bytes).
+  std::array<uint8_t, 8> short_id;
+};
+
+// Installs or clears the process-wide REALITY config. A nullopt disables
+// REALITY. The value is copied.
+NET_EXPORT void SetRealityConfig(std::optional<RealityConfig> config);
+
+// Returns the active config, or nullptr when unset or suspended.
+NET_EXPORT const RealityConfig* GetRealityConfig();
+
+// Temporarily suspends REALITY. Spider mode uses this to issue a single
+// ordinary-TLS fetch to the real target site.
+NET_EXPORT void SetRealityConfigSuspended(bool suspended);
+
+}  // namespace net
+
+#endif  // NET_SOCKET_REALITY_CONFIG_H_
