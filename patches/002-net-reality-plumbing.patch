+      if (const std::string* s = d->FindString("short_id")) {
+        if (!ParseRealityShortId(*s, &parsed_reality)) {
+          return false;
+        }
+      }
+    } else {
+      std::cerr << "Invalid reality" << std::endl;
+      return false;
+    }
+  }
+  if (const std::string* s = value.FindString("reality-server-name")) {
+    parsed_reality.server_name = *s;
+  }
+  if (const std::string* s = value.FindString("reality-public-key")) {
+    if (!ParseRealityPublicKey(*s, &parsed_reality)) {
+      return false;
+    }
+    reality_present = true;
+  }
+  if (const std::string* s = value.FindString("reality-short-id")) {
+    if (!ParseRealityShortId(*s, &parsed_reality)) {
+      return false;
+    }
+  }
+  if (reality_present) {
+    if (parsed_reality.server_name.empty()) {
