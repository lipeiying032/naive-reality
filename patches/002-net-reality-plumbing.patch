+// RFC 4648 section 5 base64url decode. Accepts optional trailing '=' padding.
+bool Base64UrlDecode(std::string_view input, std::string* output) {
+  output->clear();
+  size_t len = input.size();
+  while (len > 0 && input[len - 1] == '=') {
+    --len;
+  }
+  if (len % 4 == 1) {
+    return false;
+  }
+  auto DecodeChar = [](unsigned char c) -> int {
+    if (c >= 'A' && c <= 'Z') {
+      return c - 'A';
+    }
+    if (c >= 'a' && c <= 'z') {
+      return c - 'a' + 26;
+    }
+    if (c >= '0' && c <= '9') {
+      return c - '0' + 52;
+    }
+    if (c == '-') {
+      return 62;
+    }
+    if (c == '_') {
+      return 63;
+    }
+    return -1;
+  };
+  int quartet[4];
+  int qlen = 0;
+  for (size_t i = 0; i < len; ++i) {
+    int v = DecodeChar(static_cast<unsigned char>(input[i]));
+    if (v < 0) {
+      return false;
+    }
+    quartet[qlen++] = v;
+    if (qlen == 4) {
+      output->push_back(
+          static_cast<char>((quartet[0] << 2) | (quartet[1] >> 4)));
+      output->push_back(
+          static_cast<char>((quartet[1] << 4) | (quartet[2] >> 2)));
+      output->push_back(static_cast<char>((quartet[2] << 6) | quartet[3]));
+      qlen = 0;
+    }
+  }
+  if (qlen == 2) {
+    output->push_back(static_cast<char>((quartet[0] << 2) | (quartet[1] >> 4)));
+  } else if (qlen == 3) {
+    output->push_back(static_cast<char>((quartet[0] << 2) | (quartet[1] >> 4)));
+    output->push_back(static_cast<char>((quartet[1] << 4) | (quartet[2] >> 2)));
+  }
+  return true;
+}
+
+bool HexDecode(std::string_view input, std::string* output) {
+  output->clear();
+  if (input.size() % 2 != 0) {
+    return false;
+  }
+  auto Nibble = [](unsigned char c) -> int {
+    if (c >= '0' && c <= '9') {
+      return c - '0';
+    }
+    if (c >= 'a' && c <= 'f') {
+      return c - 'a' + 10;
+    }
+    if (c >= 'A' && c <= 'F') {
+      return c - 'A' + 10;
+    }
+    return -1;
+  };
+  for (size_t i = 0; i < input.size(); i += 2) {
+    int hi = Nibble(static_cast<unsigned char>(input[i]));
+    int lo = Nibble(static_cast<unsigned char>(input[i + 1]));
+    if (hi < 0 || lo < 0) {
+      return false;
+    }
+    output->push_back(static_cast<char>((hi << 4) | lo));
+  }
+  return true;
+}
+
+bool ParseRealityPublicKey(std::string_view str, RealityConfig* out) {
+  std::string decoded;
+  if (!Base64UrlDecode(str, &decoded) || decoded.size() != 32) {
+    std::cerr << "Invalid reality public key (expected 32 bytes base64url)"
+              << std::endl;
+    return false;
+  }
+  std::copy(decoded.begin(), decoded.end(), out->public_key.begin());
+  return true;
+}
+
+bool ParseRealityShortId(std::string_view str, RealityConfig* out) {
+  if (str.size() > 16) {
+    std::cerr << "Invalid reality short id (at most 16 hex chars)" << std::endl;
+    return false;
+  }
+  std::string decoded;
+  if (!HexDecode(str, &decoded)) {
+    std::cerr << "Invalid reality short id (hex required)" << std::endl;
+    return false;
+  }
+  out->short_id.fill(0);
+  std::copy(decoded.begin(), decoded.end(), out->short_id.begin());
+  return true;
+}
+
