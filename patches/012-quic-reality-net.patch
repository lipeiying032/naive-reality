@@ -865,6 +865,25 @@ QUICHE_EXPORT std::string KeyUpdateReasonString(KeyUpdateReason reason);
 
 using QuicSignatureAlgorithmVector = absl::InlinedVector<uint16_t, 8>;
 
+// REALITY-over-QUIC client credentials (BoringSSL extension). When set on a
+// client QuicSSLConfig, the TLS handshake seals the REALITY auth payload into
+// the ClientHello random field, skips CertificateVerify verification, and
+// overrides the SNI with server_name. This is only meaningful for client
+// connections.
+struct QUICHE_EXPORT RealityQuicConfig {
+  // Server static X25519 public key (32 bytes).
+  std::array<uint8_t, 32> public_key;
+  // Right-zero-padded short id (8 bytes).
+  std::array<uint8_t, 8> short_id;
+  // SNI presented in the ClientHello.
+  std::string server_name;
+
+  bool operator==(const RealityQuicConfig& other) const {
+    return public_key == other.public_key && short_id == other.short_id &&
+           server_name == other.server_name;
+  }
+};
